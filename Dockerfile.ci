FROM golang:1.18-alpine

# Install deps: git (for go modules), curl (for lint installer), bash, and build-base (gcc + musl + make)
RUN apk add --no-cache git curl bash build-base

# Set up environment for caching
ENV GO111MODULE=on \
    GOPATH=/go \
    GOCACHE=/go/cache

# Create cache directories
RUN mkdir -p /go/pkg /go/cache

# Install golangci-lint (binary install, lightweight)
RUN curl -fsSL -o /tmp/install-golangci.sh https://raw.githubusercontent.com/golangci/golangci-lint/master/install.sh \
    && sh /tmp/install-golangci.sh -b /usr/local/bin v1.59.0 \
    && rm /tmp/install-golangci.sh

# Default workdir (Jenkins mounts source here at runtime anyway)
WORKDIR /app
